		(uuid "0fc57257-532e-4b00-8a26-3d41953705ef")
	)
	(text "32K SRAM \nRead/Write at 5V.\n19-bit Address Bus.\n8-bit Data Bus."
		(exclude_from_sim no)
		(at 85.852 19.812 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "13ac099a-951a-456b-92ae-e48fcc99db73")
	)
	(text "Active-LOW:\nNeed to Pull-Up HIGH.\nTo signal the Z80 when \nan SD card read finishes."
		(exclude_from_sim no)
		(at 16.764 152.908 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "16093ca7-ebe7-409d-aac9-84e3b6099bcb")
	)
	(text "Active-LOW:\nuse it as a sink.\nCPU HALT -> 0V\nCPU EXEC -> 5V\ncurrent = ~5mA"
		(exclude_from_sim no)
		(at 17.018 163.068 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
