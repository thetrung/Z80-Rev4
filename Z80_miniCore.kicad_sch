				(size 1.27 1.27)
			)
		)
		(uuid "57370fa1-dd18-48a6-8eb7-0c8a7a0ba8d0")
	)
	(text "Active-LOW:\nDefault as DISABLED.\nOnly REQUEST on LOW(0)."
		(exclude_from_sim no)
		(at 16.764 104.14 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "5a614450-9af8-4779-842e-bf8d893be4ec")
	)
	(text "Active-LOW:\nDefault as DISABLED.\nOnly READ on LOW(0)."
		(exclude_from_sim no)
		(at 16.51 116.586 0)
		(effects
			(font
				(size 0.635 0.635)
