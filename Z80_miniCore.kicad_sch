	)
	(text "Active-LOW:\nNeed to Pull-Up HIGH.\nTo signal the Z80 when \nan SD card read finishes."
		(exclude_from_sim no)
		(at 18.034 132.588 0)
		(effects
			(font
				(size 0.635 0.635)
