	)
	(text "ORG $0000		;Start with Rom at 0x0000\n\nLD A, (ROM_DATA) ;Load Rom data -> register A\n\nLD ($8000), A	;Write to Ram @ 0x8000\n\nLD B, ($8000)	;Read back from Ram \n\nORG $0050\n\nROM_DATA:\n	DB $42		;Test Byte in ROM."
		(exclude_from_sim no)
		(at 103.378 147.574 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "51eb337e-6399-48d5-897f-d211376b3687")
	)
	(text "Data Bus"
		(exclude_from_sim no)
		(at 273.05 72.898 0)
		(effects
