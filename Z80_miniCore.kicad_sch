				(size 1.27 1.27)
			)
		)
		(uuid "962618ae-ab7a-481a-b80e-1b43c1392946")
	)
	(text "MicroSD Card may drain further,\nSo this 10UF is for that."
		(exclude_from_sim no)
		(at 142.494 178.308 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "9a7a7e4a-cf48-469d-82bd-03c60686ea0f")
	)
	(text "Active-LOW:\nPull-UP HIGH to Disable. \nLOW to Signal Z80 Reset."
		(exclude_from_sim no)
		(at 18.034 179.832 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "a3b6ef7a-3c01-4c86-b604-9a8ae6a9a0f3")
	)
	(text "(LOW/OR gate)"
		(exclude_from_sim no)
		(at 101.346 137.922 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a4846988-ad38-497c-b6fe-c4d0d0e1dc0b")
	)
	(text "4xPLL + FOSC/4 = 8Mhz "
		(exclude_from_sim no)
		(at 263.652 45.974 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "a8de5504-1720-4b50-b44d-fa8db14be3a4")
	)
	(text ""
		(exclude_from_sim no)
		(at 71.374 121.158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "afe48911-a934-4683-95d4-a947ca53f72a")
	)
	(text "Active-LOW:\nDisabled by Default.\nOnly need to wait for slow SRAM.\nAS6C4008 is 55ns too fast to wait."
		(exclude_from_sim no)
		(at 17.018 128.524 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "bb5efc6f-bab7-4191-a393-a2a38b31d8f4")
	)
	(text "Fixed 32K RAM \nfrom 0x8000~FFFF"
		(exclude_from_sim no)
		(at 122.682 51.308 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "bbfb6967-1dd2-4505-bda3-1bd1b9cf7415")
	)
	(text "Active-LOW:\nDefault as DISABLED.\nOnly REQUEST on LOW(0)."
		(exclude_from_sim no)
		(at 16.51 108.966 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "bccfb5be-5543-4c2e-9c27-fe4f135c4c1d")
	)
	(text "Active-LOW:\nNeed Pull-UP HIGH to keeps \nZ80 running normally until \nPIC requests the bus."
		(exclude_from_sim no)
		(at 17.018 144.018 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "c2f6c2cb-5431-4f99-b2b6-1525f6d5902e")
	)
	(text "(HIGH/OR gate)"
		(exclude_from_sim no)
		(at 102.362 129.032 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c60d6c52-186a-431a-873c-24aff98900fc")
	)
	(text "CUSTOM MMU FOR 32K-RAM + 128K-ROM :"
		(exclude_from_sim no)
		(at 87.376 106.934 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "c729dfb7-d60b-4129-a25d-bb4bac54de3b")
	)
	(text " ; Step 3: Swap the lower 32K window to ROM Page 1\n    LD A, 0x01                ; Bit 0 = 1, Bit 1 = 0 -> Binary %01 (Page 1)\n    OUT (BANK_REG), A         ; 74HC138 flashes Y2, 74HC273 updates ROM A15=1, A16=0\n\n ; Step 4: Access data sitting in ROM Page 1 safely from inside RAM\n    LD HL, 0x4000             ; Point to an arbitrary test address inside ROM Page 1\n    LD A, (HL)                ; Read the byte from ROM Page 1 into Accumulator A\n    LD (0x9000), A            ; Store that data safely inside a fixed SRAM address\n"
		(exclude_from_sim no)
		(at 53.34 165.1 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "cba1a693-12cd-4161-87c7-545190780d87")
	)
	(text "Bit-bang SPI :\nRA3 -> MOSI \nRA4 -> MISO"
		(exclude_from_sim no)
		(at 191.77 159.258 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "cca119cd-6b34-48f4-8701-920c8ab0bbab")
	)
	(text "Active-LOW"
		(exclude_from_sim no)
		(at 264.16 53.086 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "d373d569-5425-4c97-9766-330e6fd70687")
	)
	(text "CPU Instruction\nFetch Cycles"
		(exclude_from_sim no)
		(at 22.606 27.94 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "d60e6663-c7af-4ff0-8246-10db9a4a58d2")
	)
	(text "How To Write new ROM:\nPC Signal > UART > PIC1-MMU.\n\nPIC1-MMU:\nPULL BUSREQ -> Z80 release All-Bus.\nPULL ROM_CE=LOW && RAM_CE=HIGH\nSEND REQ: IORQ/WR=LOW + RD/M1=HIGH\nSEND (A0..A7) = UPDATE_ROM\n\nPIC2-LOADER: \nWRITE DATA(SD) -> EEPROM\nPULL IORQ/WR/BUSREQ=HIGH when done.\n\nPIC1-MMU: \nListen & Trigger RESET to reboot Z80."
		(exclude_from_sim no)
		(at 249.936 25.654 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "deebaa45-f21c-44fc-88a0-7e32b63b8488")
	)
	(text "> Z80 release All-Bus."
		(exclude_from_sim no)
		(at 263.652 43.434 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "eb13ae31-c03a-4258-ac74-adc28d3be70a")
	)
	(text "UART"
		(exclude_from_sim no)
		(at 268.478 57.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f0a23766-7d66-4baa-9be7-a86a1233cf34")
	)
	(text "Z80: IN A, (DATA_PORT)\nRD = LOW(0)\nIORQ = LOW(0)\nMEMREQ = HIGH(1)\nWR = HIGH(1)\n(A0..A7) = DATA_PORT"
		(exclude_from_sim no)
		(at 174.498 58.166 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f3d06678-c77f-4f3b-a543-c07cbe7edc0e")
	)
