	)
	(text "Forces SRAM to output data to \nthe bus during a read cycle."
		(exclude_from_sim no)
		(at 127.762 53.594 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "6af010d8-d904-49a5-90aa-899495dfbcd5")
	)
	(text "MMU ROLES:\nBus Controller.\nPulze Z80_CLK @Mhz.\nChip Select RAM/ROM.\nBank Memory in RAM/ROM.\nDisplay/Access I2C PORT.\nExchange Data <-> UART_PORT."
		(exclude_from_sim no)
		(at 207.772 19.812 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "6b0ef437-11f5-436a-b614-4746d99a623f")
	)
	(text "32K EEPROM \nRead/Write at 5V.\n16-bit Address Bus.\n8-bit Data Bus."
		(exclude_from_sim no)
		(at 145.542 24.892 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "708f1f66-9bd8-4698-ad73-ac3a214b2a78")
	)
	(text "Active-LOW :\nIt must be tied High via \na resistor to prevent random, \nunrecoverable system resets."
		(exclude_from_sim no)
