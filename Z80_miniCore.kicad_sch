		(uuid "018c53c4-c76d-4394-b4f7-50cd10fdaabf")
	)
	(text "Tells SRAM to lock in data from \nthe bus during a write cycle."
		(exclude_from_sim no)
		(at 127.762 56.388 0)
		(effects
			(font
